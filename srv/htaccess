# PodTube PWA - static pages + one CGI (api.cgi).  The code is not in the web root: it lives in ~/.podtube/
Options -Indexes
DirectoryIndex index.html

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType application/javascript .js
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/manifest+json text/plain image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # The server sends no Cache-Control: the page, the manifest and the service worker must be revalidated.  The hashed files
    # under assets/ never change; they get a long lifetime from their own assets/.htaccess (htaccess-assets).
    <FilesMatch "\.(html|webmanifest)$|^sw\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
